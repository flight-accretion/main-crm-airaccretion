diff --git a/tests/Unit/InvoiceCancelledAndAdjustedExportsTest.php b/tests/Unit/InvoiceCancelledAndAdjustedExportsTest.php
index 11ad831a..b021e1af 100644
--- a/tests/Unit/InvoiceCancelledAndAdjustedExportsTest.php
+++ b/tests/Unit/InvoiceCancelledAndAdjustedExportsTest.php
@@ -753,4 +753,109 @@ private function createSchema(): void
             $table->timestamps();
         });
     }
+public function test_paid_booking_remains_in_original_month_after_sales_followups(): void
+{
+    $this->actingAs($this->createAdminUser());
+
+    $scenario = $this->createPaidCancelledScenario(40000);
+    $lead = $scenario['lead'];
+
+    // Adapt the existing financial fixture to a paid,
+    // non-cancelled booking.
+    $scenario['followup']->update([
+        'status' => LeadFollowup::STATUS_PARTIAL_PAYMENT_RECEIVED,
+    ]);
+
+    $salesFollowup = LeadFollowup::forceCreate([
+        'id' => (string) Str::uuid(),
+        'lead_id' => $lead->id,
+        'status' => LeadFollowup::STATUS_SALES_FOLLOW_UP,
+        'total_amount' => 75000,
+        'received_amount' => 0,
+        'service_ids' => [],
+        'extra_service_ids' => [],
+        'service_details' => [],
+        'created_at' => '2026-08-25 10:00:00',
+        'updated_at' => '2026-08-25 10:00:00',
+    ]);
+
+    $cohort = app(
+        \App\Services\Sales\SalesBookingCohortService::class
+    );
+
+    $augustIds = $cohort->leadIdsForPeriod(
+        \Carbon\Carbon::parse('2026-08-01'),
+        \Carbon\Carbon::parse('2026-08-31')
+    );
+
+    $this->assertTrue($augustIds->contains($lead->id));
+
+    $salesPeriod = app(
+        \App\Services\Reports\ProfitLossSummaryService::class
+    )->forPeriod(
+        \Carbon\Carbon::parse('2026-08-01'),
+        \Carbon\Carbon::parse('2026-08-31')
+    );
+
+    $this->assertSame(1, $salesPeriod['lead_count']);
+    $this->assertSame(75000.0, $salesPeriod['booking_revenue']);
+    $this->assertSame(65000.0, $salesPeriod['booking_profit']);
+
+    // Later follow-up in another month must not create
+    // another booking or change the original cohort.
+    $closeFollowup = LeadFollowup::forceCreate([
+        'id' => (string) Str::uuid(),
+        'lead_id' => $lead->id,
+        'status' => LeadFollowup::STATUS_CLOSE_FOLLOW_UP,
+        'total_amount' => 75000,
+        'received_amount' => 0,
+        'service_ids' => [],
+        'extra_service_ids' => [],
+        'service_details' => [],
+        'created_at' => '2026-09-02 10:00:00',
+        'updated_at' => '2026-09-02 10:00:00',
+    ]);
+
+    $septemberIds = $cohort->leadIdsForPeriod(
+        \Carbon\Carbon::parse('2026-09-01'),
+        \Carbon\Carbon::parse('2026-09-30')
+    );
+
+    $this->assertFalse($septemberIds->contains($lead->id));
+
+    $report = app(ReportController::class)->profitLossReport(
+        Request::create('/admin/report/profit-loss', 'GET', [
+            'from_payment_date' => '2026-08-01',
+            'to_payment_date' => '2026-08-31',
+        ])
+    );
+
+    $reportRow = $report->getData()['profitLossData']->first();
+
+    $this->assertNotNull($reportRow);
+    $this->assertSame(
+        $closeFollowup->id,
+        $reportRow->followup_id
+    );
+    $this->assertSame(65000.0, (float) $reportRow->profit_loss);
+
+    $augustExport = (new ProfitLossReportExport([
+        'from_payment_date' => '2026-08-01',
+        'to_payment_date' => '2026-08-31',
+    ]))->collection();
+
+    $this->assertCount(1, $augustExport);
+    $this->assertSame(
+        65000.0,
+        (float) $augustExport->first()->profit_loss
+    );
+
+    $septemberExport = (new ProfitLossReportExport([
+        'from_payment_date' => '2026-09-01',
+        'to_payment_date' => '2026-09-30',
+    ]))->collection();
+
+    $this->assertCount(0, $septemberExport);
+}
+
 }
